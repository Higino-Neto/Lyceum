VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Optional for web/dev overrides. Leave empty in desktop production so Lyceum uses lyceum://auth/reset-password.
VITE_AUTH_REDIRECT_BASE_URL=""
# Optional mobile APK updater override. Defaults to the latest GitHub Release manifest.
VITE_MOBILE_APK_UPDATE_MANIFEST_URL=""
# Optional: enables "Sign in with Google" for Send to Kindle by e-mail.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID > "Desktop app".
# Enable the Gmail API and add the gmail.send scope to the consent screen.
VITE_GOOGLE_OAUTH_CLIENT_ID=""
VITE_GOOGLE_OAUTH_CLIENT_SECRET=""
