{
  "name": "lyceum",
  "private": true,
  "version": "1.9.0",
  "author": "Higino-Neto",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1",
    "clean:build": "node scripts/clean-build.mjs",
    "size:audit": "node scripts/size-audit.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "node scripts/prepare-pdfjs.mjs && node scripts/verify-pdfjs-assets.mjs && tsc && vite build && node scripts/verify-electron-imports.mjs && node scripts/verify-electron-workers.mjs",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "mobile:ota": "npm run build:mobile && node scripts/prepare-mobile-ota.mjs",
    "mobile:native-assets": "node scripts/prepare-native-mobile-assets.mjs",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm -c.compression=normal --publish never",
    "release:validate-version": "node scripts/release/validate-version.mjs",
    "release:validate-artifacts": "node scripts/release/validate-artifacts.mjs",
    "release:notes": "node scripts/release/generate-notes.mjs",
    "release:checksums": "node scripts/release/generate-checksums.mjs",
    "release:verify-legacy": "node scripts/release/verify-legacy-build.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "native:node": "node scripts/ensure-node-native.mjs",
    "pretest": "node scripts/ensure-node-native.mjs",
    "pretest:run": "node scripts/ensure-node-native.mjs",
    "pretest:ui": "node scripts/ensure-node-native.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:pdf:electron": "electron scripts/smoke-pdfjs-electron.cjs",
    "test:mobile": "vitest run src/test/mobileLibrary.test.ts src/test/mobileReadingStats.test.ts src/test/mobileReleaseResolver.test.ts src/test/mobileReleaseWorkflow.test.ts src/test/mobileOtaUpdater.test.ts src/test/mobileAuth.test.ts src/test/nativeApkUpdater.test.ts src/test/pdfReaderModel.test.ts src/test/mobileReaderModel.test.ts src/test/mobileComponents.test.tsx src/test/mobileReadingEntry.test.tsx"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capgo/capacitor-updater": "^8.46.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@napi-rs/canvas": "^0.1.100",
    "@supabase/supabase-js": "^2.95.3",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "sharp": "^0.34.5",
    "sigma": "^3.0.3",
    "tar": "^7.5.22",
    "wink-lemmatizer": "^3.0.4",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capgo/cli": "^7.106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chokidar": "^1.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@uiw/react-heat-map": "^2.3.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.24",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "epubjs": "^0.3.93",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "lucide-react": "^0.564.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.4.0"
  },
  "main": "dist-electron/main.js"
}
